# AWS Lambda container image
# Pinned by digest: AWS republishes the lambda base tags, and this image supplies
# the BLAS pandas computes against.
FROM public.ecr.aws/lambda/python:3.12-x86_64@sha256:ec6a76e824a7d8f00d98e6ae9a68a3937d0c004d3fa5f49432de1c4c289592cc

ENV OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --only-binary=:all: -r requirements.txt

COPY app/ app/

# Mangum handler exported as app.main.handler
CMD ["app.main.handler"]
