# --- AniLove DB (shared RDS across EC2 / ECS / Lambda) ---
DB_NAME=anilove
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=rds.xxxxxx.sa-east-1.rds.amazonaws.com
DB_PORT=5432

# TLS to RDS: ON by default. Only set false for local Docker Postgres.
DB_SSL=true
# Set true if you mount the Amazon RDS CA and want full cert verification
DB_SSL_REJECT_UNAUTHORIZED=false

# Isolate tables per compute platform on the SAME database:
#   EC2    → DB_SCHEMA=ec2
#   ECS    → DB_SCHEMA=ecs
#   Lambda → DB_SCHEMA=lambda
#   Local  → DB_SCHEMA=public  (or local)
DB_SCHEMA=ec2

DB_POOL_MIN=0
DB_POOL_MAX=20

JWT_SECRET=secret
PORT=3000
NODE_ENV=production
SERVICE_NAME=anilove
