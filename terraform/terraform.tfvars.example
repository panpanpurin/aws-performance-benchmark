aws_region   = "ap-northeast-1"
project_name = "aws-perf-bench"

# Set both for ACM + Route 53 aliases. Leave empty for HTTP-only ALB.
domain_name     = ""
route53_zone_id = ""

# Empty = resolve from SSM (pin ids for stable runs)
ec2_ami_id = ""
ecs_ami_id = ""

# Non-burstable: CPU credits would otherwise vary between platforms and across
# repeated runs. t2 defaults to standard and t3 to unlimited, so burstable types
# also need cpu_credits set explicitly (below).
ec2_instance_type = "c6i.large"
ecs_instance_type = "c6i.large"

# Only applies if a burstable (t2/t3/t4g) type is selected above.
cpu_credits = "standard"

ecs_task_cpu              = 1024
ecs_task_memory           = 1024
ecs_service_desired_count = 0

# 1769 MB is where Lambda allocates one full vCPU, matching the 1 vCPU that
# EC2 and ECS containers are capped at. Lambda couples CPU to memory, so this
# necessarily gives Lambda more RAM than the other platforms.
lambda_memory_mb    = 1769
lambda_ephemeral_mb = 1024
lambda_timeout_s    = 30

# 1 gives Lambda one worker, the same as one EC2 container and one ECS task, so
# provisioned capacity is equal across platforms. Set to -1 to let Lambda scale
# to the account limit, which measures elasticity rather than the compute model.
lambda_reserved_concurrency = 1

# Register the functions as ALB targets so all three platforms are reached
# through the same load balancer and the same request path. The Function URLs
# stay published either way and remain what Prometheus scrapes for /metrics.
lambda_behind_alb = true

# Non-burstable, for the same reason as c6i.large on EC2/ECS: CPU credits carry
# across runs, and this database is shared by all three platforms and sits in
# the critical path of the only I/O-bound workload. Burstable classes also
# cannot run Performance Insights, which is what backs the interference claim.
rds_instance_class    = "db.m6g.large"
rds_engine_version    = "17.6"
rds_allocated_storage = 20
rds_db_name           = "anilove"
rds_username          = "anilove"

alb_ssl_policy     = "ELBSecurityPolicy-TLS13-1-2-2021-06"
log_retention_days = 14

enable_nat_gateway = true
enable_rds         = true

# After ECR push
enable_ec2    = false
enable_ecs    = false
enable_lambda = false

ecr_image_tag        = "latest"
ecr_lambda_image_tag = "lambda"

# image_digest_anilove           = "sha256:..."
# image_digest_csv               = "sha256:..."
# image_digest_thumbnail         = "sha256:..."
# image_digest_lambda_anilove    = "sha256:..."
# image_digest_lambda_csv        = "sha256:..."
# image_digest_lambda_thumbnail  = "sha256:..."

create_deploy_role             = false
deploy_role_trusted_principals = []

write_benchmark_targets = true

tags_extra = {
  Owner = "benchmark"
}
