#!/bin/bash
set -euo pipefail

dnf update -y || true
dnf install -y docker aws-cli jq
systemctl enable --now docker

REGION="${aws_region}"
APP="${app_name}"
PORT="${app_port}"
IMAGE="${image_ref}"
DB_SCHEMA="${db_schema}"

if [[ -n "$IMAGE" ]]; then
  ACCOUNT=$(aws sts get-caller-identity --query Account --output text --region "$REGION")
  aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$ACCOUNT.dkr.ecr.$REGION.amazonaws.com"
  docker pull "$IMAGE"

  ENV_ARGS=()
  ENV_ARGS+=(-e "PORT=$PORT")
  ENV_ARGS+=(-e "NODE_ENV=production")

  if [[ "${needs_rds}" == "true" && -n "${db_secret_arn}" ]]; then
    SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "${db_secret_arn}" --region "$REGION" --query SecretString --output text)
    ENV_ARGS+=(-e "DB_HOST=$(echo "$SECRET_JSON" | jq -r .host)")
    ENV_ARGS+=(-e "DB_PORT=$(echo "$SECRET_JSON" | jq -r .port)")
    ENV_ARGS+=(-e "DB_NAME=$(echo "$SECRET_JSON" | jq -r .dbname)")
    ENV_ARGS+=(-e "DB_USER=$(echo "$SECRET_JSON" | jq -r .username)")
    ENV_ARGS+=(-e "DB_PASSWORD=$(echo "$SECRET_JSON" | jq -r .password)")
    ENV_ARGS+=(-e "DB_SCHEMA=$DB_SCHEMA")
    ENV_ARGS+=(-e "DB_SSL=true")
  fi

  if [[ "${needs_rds}" == "true" && -n "${jwt_secret_arn}" ]]; then
    JWT_JSON=$(aws secretsmanager get-secret-value --secret-id "${jwt_secret_arn}" --region "$REGION" --query SecretString --output text)
    ENV_ARGS+=(-e "JWT_SECRET=$(echo "$JWT_JSON" | jq -r .JWT_SECRET)")
  fi

  docker rm -f "$APP" 2>/dev/null || true
  # --cpus / --memory give the container the same budget as the ECS task
  # definition (cpu 1024 = 1 vCPU, memory 1024 MB). Without them the container
  # would use the whole instance, so a host larger than the ECS task would give
  # EC2 more CPU than the other platforms and invalidate the comparison.
  # --no-healthcheck disables the HEALTHCHECK baked into the image. It spawns a
  # whole node process every 10s, which on a container capped at 1 vCPU is CPU
  # taken from the workload - and only here: ECS ignores the image HEALTHCHECK
  # because the task definition declares none, and Lambda has no equivalent. The
  # ALB target group is the health authority for every platform.
  docker run -d --name "$APP" --restart unless-stopped --no-healthcheck \
    --cpus="${container_cpus}" --memory="${container_memory_mb}m" \
    -p "$PORT:$PORT" "$${ENV_ARGS[@]}" "$IMAGE"
fi
